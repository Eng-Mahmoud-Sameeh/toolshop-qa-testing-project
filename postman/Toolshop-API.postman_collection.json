                ]
              }
            }
          ]
        },
        {
          "name": "Search products: 'pliers'",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/search?q=pliers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "pliers"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const results = pm.response.json().data;",
                  "pm.test(\"Results are returned\", () => pm.expect(results).to.be.an(\"array\").that.is.not.empty);",
                  "pm.test(\"Every result contains 'pliers'\", () => results.forEach(p => pm.expect(p.name.toLowerCase()).to.include(\"pliers\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search products: no match",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/search?q=xyz123",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "xyz123"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"No products are returned\", () => pm.expect(pm.response.json().data).to.be.an(\"array\").that.is.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sort products by price ascending",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?sort=price,asc&page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "price,asc"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const prices = pm.response.json().data.map(p => p.price);",
                  "pm.test(\"Prices go from low to high\", () => {",
                  "    const sorted = [...prices].sort((a, b) => a - b);",
                  "    pm.expect(prices).to.eql(sorted);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List brands",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/brands",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "brands"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const brands = pm.response.json();",
                  "pm.test(\"Brands are returned\", () => pm.expect(brands).to.be.an(\"array\").that.is.not.empty);",
                  "pm.test(\"ForgeFlex Tools exists\", () => pm.expect(brands.map(b => b.name)).to.include(\"ForgeFlex Tools\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Category tree",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories/tree",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories",
                "tree"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const tree = pm.response.json();",
                  "pm.test(\"Top-level categories exist\", () => pm.expect(tree.map(c => c.name)).to.include.members([\"Hand Tools\", \"Power Tools\"]));"
                ]
              }
            }
          ]
        }
      ]
