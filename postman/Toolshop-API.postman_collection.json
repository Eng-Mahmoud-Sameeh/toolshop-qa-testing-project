{
  "info": {
    "_postman_id": "9393c073-f229-4f8a-8276-e8f749aae84f",
    "name": "Toolshop API Tests",
    "description": "API tests for the Practice Software Testing (Toolshop) REST API.\n\nRun the folders in order: 01 creates a user and a token, 02 picks a product, 03 builds a cart and places an order.\n\nRun from the command line:\nnewman run postman/Toolshop-API.postman_collection.json -e postman/toolshop.postman_environment.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Users and Authentication",
      "item": [
        {
          "name": "Register a new customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "register"
              ]
            },
            "description": "Creates a fresh customer. Positive test, also used as setup for the rest of the collection.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Api\",\n  \"last_name\": \"Tester\",\n  \"dob\": \"1995-05-15\",\n  \"phone\": \"0612345678\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"address\": {\n    \"street\": \"Lesingel\",\n    \"house_number\": \"12\",\n    \"city\": \"Steensel\",\n    \"state\": \"Noord-Holland\",\n    \"country\": \"NL\",\n    \"postal_code\": \"1012AB\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique email every run, so the collection never depends on shared demo accounts.",
                  "const stamp = Date.now();",
                  "pm.collectionVariables.set(\"email\", `api.mahmoud.${stamp}@example.com`);",
                  "pm.collectionVariables.set(\"password\", \"Toolshop#2026Qa\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));",
                  "const user = pm.response.json();",
                  "pm.test(\"Response has an id\", () => pm.expect(user.id).to.be.a(\"string\").and.not.empty);",
                  "pm.test(\"Email is saved correctly\", () => pm.expect(user.email).to.eql(pm.collectionVariables.get(\"email\")));",
                  "pm.test(\"Password is NOT returned\", () => pm.expect(user).to.not.have.property(\"password\"));",
                  "pm.collectionVariables.set(\"userId\", user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register with an email that already exists",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "register"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Api\",\n  \"last_name\": \"Tester\",\n  \"dob\": \"1995-05-15\",\n  \"phone\": \"0612345678\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"address\": {\n    \"street\": \"Lesingel\",\n    \"house_number\": \"12\",\n    \"city\": \"Steensel\",\n    \"state\": \"Noord-Holland\",\n    \"country\": \"NL\",\n    \"postal_code\": \"1012AB\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Duplicate email is rejected (409 or 422)\", () => pm.expect(pm.response.code).to.be.oneOf([409, 422]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with valid credentials",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Returns an access token\", () => pm.expect(body.access_token).to.be.a(\"string\").and.not.empty);",
                  "pm.test(\"Token type is bearer\", () => pm.expect(body.token_type.toLowerCase()).to.eql(\"bearer\"));",
                  "pm.test(\"Response time is below 3 s\", () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "pm.collectionVariables.set(\"token\", body.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with wrong password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"Wrong#Pass123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401 Unauthorized\", () => pm.response.to.have.status(401));",
                  "pm.test(\"No token is returned\", () => pm.expect(pm.response.json()).to.not.have.property(\"access_token\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login without password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Missing password is rejected (4xx)\", () => pm.expect(pm.response.code).to.be.within(400, 499));",
                  "pm.test(\"No token is returned\", () => pm.expect(pm.response.text()).to.not.include(\"access_token\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get my profile (with token)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const me = pm.response.json();",
                  "pm.test(\"Profile belongs to the logged-in user\", () => pm.expect(me.email).to.eql(pm.collectionVariables.get(\"email\")));",
                  "pm.test(\"First name is correct\", () => pm.expect(me.first_name).to.eql(\"Api\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get my profile without token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401 Unauthorized\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Products",
      "item": [
        {
          "name": "List products (page 1)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test(\"Page 1 is returned\", () => pm.expect(page.current_page).to.eql(1));",
                  "pm.test(\"Products are returned\", () => pm.expect(page.data).to.be.an(\"array\").that.is.not.empty);",
                  "pm.test(\"Every product has id, name and a positive price\", () => {",
                  "    page.data.forEach(p => {",
                  "        pm.expect(p.id).to.be.a(\"string\").and.not.empty;",
                  "        pm.expect(p.name).to.be.a(\"string\").and.not.empty;",
                  "        pm.expect(p.price).to.be.above(0);",
                  "    });",
                  "});",
                  "pm.test(\"Response time is below 3 s\", () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "// Save an in-stock product for the cart tests (IDs change when the site resets, so never hard-code them).",
                  "const product = page.data.find(p => p.in_stock) || page.data[0];",
                  "pm.collectionVariables.set(\"productId\", product.id);",
                  "pm.collectionVariables.set(\"productName\", product.name);",
                  "pm.collectionVariables.set(\"productPrice\", product.price);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get one product by id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "pm.test(\"Correct product is returned\", () => pm.expect(p.id).to.eql(pm.collectionVariables.get(\"productId\")));",
                  "pm.test(\"Name matches the list\", () => pm.expect(p.name).to.eql(pm.collectionVariables.get(\"productName\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get product with unknown id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
